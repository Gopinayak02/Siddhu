SIDDHU_NAME=Siddhu
SIDDHU_WAKEWORD=hey_jarvis
SIDDHU_LANGUAGE=auto

# Audio
SIDDHU_INPUT_RATE=16000
SIDDHU_CHANNELS=1
SIDDHU_QUEUE_SIZE=50
SIDDHU_COMMAND_SECONDS=8

# Wake word
SIDDHU_WAKE_THRESHOLD=0.50
SIDDHU_WAKE_MODEL=models/wakeword/hey_jarvis_v0.1.tflite
SIDDHU_WAKE_BACKEND=auto

# STT
SIDDHU_STT_MODEL=base
SIDDHU_STT_DEVICE=cpu
SIDDHU_STT_COMPUTE_TYPE=int8

# Piper
SIDDHU_PIPER_MODEL=models/piper/en_US-lessac-medium.onnx

# AI Router (OpenAI-compatible adapter)
OMNI_ROUTER_URL=
OMNI_ROUTER_API_KEY=
OMNI_ROUTER_MODEL=
OMNI_ROUTER_TIMEOUT=60

# Paths
SIDDHU_ROOT=.
SIDDHU_DATA_DIR=data
SIDDHU_MODEL_DIR=models
SIDDHU_LOG_DIR=logs
